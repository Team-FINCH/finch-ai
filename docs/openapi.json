      },
      "DataAsOf": {
        "description": "데이터 원천별 기준 시각. UI에 반드시 노출한다.\n\n시세는 지연될 수 있으므로 생성 시각과 별도로 관리한다.",
        "properties": {
          "filings": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filings"
          },
          "macro": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Macro"
          },
          "news": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "News"
          },
          "portfolio": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portfolio"
          },
          "price": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          }
        },
        "title": "DataAsOf",
        "type": "object"
      },
      "Envelope_dict_": {
        "properties": {
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"

    "securitySchemes": {
      "bearerAuth": {
        "description": "사용자 식별자는 토큰에서만 읽는다. 경로나 본문으로 받지 않는다. 개발 환경에서는 비어 있지 않은 아무 문자열이나 통과한다.",
        "scheme": "bearer",
        "type": "http"
      }
    }

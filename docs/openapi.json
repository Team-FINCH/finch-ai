          "quantity": {
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          },
          "side": {
            "$ref": "#/components/schemas/OrderSide"
          },
          "ticker": {
            "maxLength": 6,
            "minLength": 6,
            "title": "Ticker",
            "type": "string"
          }
        },
        "required": [
          "ticker",
          "side",
          "quantity"
        ],
        "title": "OrderLine",
        "type": "object"
      },
      "OrderSide": {
        "enum": [
          "buy",
          "sell"
        ],
        "title": "OrderSide",
        "type": "string"
      },
      "Period": {
        "enum": [
          "1d",
          "1w",
          "1m",
          "3m",
          "ytd"

            "minItems": 1,
            "title": "Orders",
            "type": "array"
          }
        },
        "required": [
          "orders"
        ],
        "title": "PreviewRequest",
        "type": "object"
      },
      "Screen": {
        "description": "대화에서 대명사 지시 대상을 해소하는 데 쓴다.",
        "enum": [
          "home",
          "portfolio",
          "stock_detail",
          "order",
          "chat"

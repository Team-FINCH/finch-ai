      "FeedbackReason": {
        "description": "이 분포가 프롬프트 개선의 우선순위를 정한다. 응답 정책 §7.1 참조.",
        "enum": [
          "wrong_number",
          "not_relevant",
          "outdated",
          "too_generic",
          "unclear",
          "wrong_citation"
        ],
        "title": "FeedbackReason",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrderLine": {
        "properties": {
          "price": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }

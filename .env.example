# 시세 — 한국투자증권 OpenAPI (모의투자 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# 공시 · 재무 — DART OpenAPI
DART_API_KEY=

# 뉴스 — 네이버 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 거시지표 — 한국은행 ECOS
ECOS_API_KEY=

# 지수 시계열 · 시가총액 — KRX OpenAPI (data-dbg.krx.co.kr)
KRX_API_KEY=

# LLM — GMS (OpenAI 호환 Chat Completions)
GMS_KEY=
GMS_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# RAG 임베딩 — GMS LLM 키와 별도로 관리한다.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 저장소
DATABASE_URL=postgresql+asyncpg://ai_invest:ai_invest@localhost:5432/ai_invest

# 백엔드 원장 조회 (§11 — 읽기 전용)
BACKEND_BASE_URL=http://localhost:8080
BACKEND_SERVICE_TOKEN=

# 백엔드 명세 §9 — 헤더 두 개가 짝이다. 백엔드가 다른 이름을 쓰면 여기만 바꾼다.
# X-User-Id 는 검증 없이 신뢰하므로 AI 서버는 내부 네트워크에서만 접근 가능해야 한다.
# BACKEND_SERVICE_TOKEN 이 비어 있으면 APP_ENV=local 에서만 토큰 검증을 건너뛴다.
TRUSTED_USER_HEADER=X-User-Id
INTERNAL_TOKEN_HEADER=X-Internal-Token

# 원장을 어디서 읽을지: seed | backend | none
#   seed    — tests/fixtures 의 JSON. 백엔드가 열리기 전 기본값이다
#   backend — 보유·거래는 백엔드 /internal/v1, 시계열·섹터는 우리 DB.
#             백엔드가 /internal/v1 을 구현하기 전에는 쓸 수 없다
#   none    — 원장 없음. 개인화 섹션이 비활성된다
LEDGER_SOURCE=seed

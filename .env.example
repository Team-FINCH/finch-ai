# 시세 — 한국투자증권 OpenAPI (모의투자 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# 공시 · 재무 — DART OpenAPI
DART_API_KEY=

# 뉴스 — NAVER API HUB Application 인증정보 (NCP IAM Access Key가 아니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 거시지표 — 한국은행 ECOS
ECOS_API_KEY=

# 지수 시계열 · 시가총액 — KRX OpenAPI (data-dbg.krx.co.kr)
KRX_API_KEY=

# LLM — GMS (OpenAI 호환 Chat Completions)
GMS_KEY=
GMS_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano
# 최초 1회 + 재생성. GMS 크레딧의 대부분이 재생성에서 나간다. 조이려면 1.
LLM_MAX_ATTEMPTS=2
# 종목분석 공용 섹션 캐시 시간. 길수록 같은 종목 재생성이 줄어든다.
ANALYSIS_CACHE_TTL_H=24

# 사용자별 보호 한도. 0 이하인 일일 토큰 예산은 예산 검사를 끈다.
AI_RATE_LIMIT_WINDOW_S=60
AI_RATE_LIMIT_STOCKS_PER_MINUTE=10
AI_RATE_LIMIT_CHAT_PER_MINUTE=20
AI_RATE_LIMIT_PORTFOLIO_PER_MINUTE=10
AI_RATE_LIMIT_ORDERS_PER_MINUTE=30
AI_RATE_LIMIT_BRIEFING_PER_MINUTE=60
AI_DAILY_TOKEN_BUDGET=500000
AI_GMS_RESERVATION_TOKENS=20000
AI_GMS_RESERVATION_TTL_S=300

# 배치 전용 토큰 장부. 사용자 개인 예산과 분리해 집계하며, 소진되면 남은 대상을
# 남겨 두고 멈춘다. 0 이하면 배치 예산 검사를 끈다.
AI_BATCH_DAILY_TOKEN_BUDGET=2000000

# 데일리 브리핑 배치 재시도
BRIEFING_BATCH_ATTEMPTS=3
BRIEFING_BATCH_BACKOFF_S=1.0

# 응답 데이터 최신성 경고 기준(초)
FRESHNESS_PRICE_S=1200
FRESHNESS_PORTFOLIO_S=900
FRESHNESS_FILINGS_S=86400
FRESHNESS_NEWS_S=21600
FRESHNESS_MACRO_S=604800

# RAG 임베딩도 위 GMS 키와 base URL을 공유한다.

# 저장소
DATABASE_URL=postgresql+asyncpg://ai_invest:ai_invest@localhost:5432/ai_invest

# 백엔드 원장 조회 (§11 — 읽기 전용)
BACKEND_BASE_URL=http://localhost:8080
BACKEND_SERVICE_TOKEN=

# 백엔드 명세 §9 — 헤더 두 개가 짝이다. 백엔드가 다른 이름을 쓰면 여기만 바꾼다.
# X-User-Id 는 검증 없이 신뢰하므로 AI 서버는 내부 네트워크에서만 접근 가능해야 한다.
# BACKEND_SERVICE_TOKEN 이 비어 있으면 APP_ENV=local 에서만 토큰 검증을 건너뛴다.
TRUSTED_USER_HEADER=X-User-Id
INTERNAL_TOKEN_HEADER=X-Internal-Token

# 원장을 어디서 읽을지: seed | backend | none
#   seed    — tests/fixtures 의 JSON. 백엔드가 열리기 전 기본값이다
#   backend — 보유·거래는 백엔드 /internal/v1, 시계열·섹터는 우리 DB.
#             백엔드가 /internal/v1 을 구현하기 전에는 쓸 수 없다
#   none    — 원장 없음. 개인화 섹션이 비활성된다
LEDGER_SOURCE=backend
